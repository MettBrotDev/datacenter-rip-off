config_version=5

[application]
config/name="Datacenter Rip Off"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]
Net="*res://scripts/net.gd"
Settings="*res://scripts/settings.gd"

[display]
window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/use_debanding=true
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=2
environment/ssao/quality=2
environment/ssil/quality=1
reflections/sky_reflections/roughness_layers=8

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=120

[shader_globals]

indoor={
"type": "float",
"value": 0.0
}
